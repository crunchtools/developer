#!/usr/bin/env python3
"""Tell /agents whether this seat is busy and who is driving it.

Run by Claude Code's managed hooks (40-claude-seat.json) with the event on
stdin, and writes ~/.claude/seat-state.json:

  seat-state prompt   UserPromptSubmit. Every prompt starts a turn: turn is
                      active from turn_started. A prompt a person typed also
                      marks the seat busy and manual, with the session's
                      first prompt as its task. Turns Claude Code starts
                      itself reach this hook too: a cross-session message
                      (Josui Prime's assignments) opening with
                      <cross-session-message>, and a background task's
                      result opening with <task-notification>. They leave
                      state, owner and task alone.
  seat-state stop     Stop and StopFailure, and the idle_prompt Notification.
                      The turn is over: turn is idle from turn_ended. A turn
                      a person interrupts with Esc runs no Stop, but its end
                      arms the idle_prompt timer like any other, which fires
                      a minute later unless someone types meanwhile. An idle
                      seat keeps its first turn_ended, and idle_prompt leaves
                      alone a turn that started too recently to be the one
                      it reports on.

Every handler reads, changes and replaces the file under an exclusive flock on
~/.claude/.seat-state.lock, so two hooks running at once cannot interleave.
  seat-state start    SessionStart. A new process (startup, resume) or a
                      /clear is not mid-turn, so turn is idle. source=clear
                      also frees the seat and pins the new conversation's
                      UUID for claude-worker, so a respawn does not
                      bring back the cleared one. source=compact can come
                      mid-turn and changes nothing.

A hook must never stand between a person and their prompt: every failure is
reported on stderr and the exit is 0. Nothing goes to stdout, which
UserPromptSubmit would add to the conversation.
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import sys
import tempfile
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any

TASK_LENGTH = 120
# Claude Code's messageIdleNotifThresholdMs: idle_prompt comes at least this
# long after the turn it reports on ended.
IDLE_NOTICE_AFTER = timedelta(seconds=60)
# What Claude Code puts first in a prompt it submits on its own.
HARNESS_MARKS = ("<cross-session-message", "<task-notification")
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def write_atomically(path: Path, text: str) -> None:
    """Replace path in one step, through a temporary file beside it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def read_state(path: Path) -> dict[str, Any]:
    """The seat's state, or {} when there is none yet or it cannot be used."""
    try:
        state = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        print(f"seat-state: {path} is unreadable, replacing it: {exc}", file=sys.stderr)
        return {}
    if not isinstance(state, dict):
        print(f"seat-state: {path} is not a JSON object, replacing it", file=sys.stderr)
        return {}
    return state


def now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


def idle(state: dict[str, Any]) -> dict[str, Any]:
    """state with the turn over as of now."""
    return {**state, "turn": "idle", "turn_ended": now()}


def on_prompt(event: dict[str, Any], state_path: Path) -> None:
    """UserPromptSubmit: a turn starts; a typed prompt makes the seat busy and manual."""
    prompt = str(event.get("prompt", ""))
    session = str(event.get("session_id", ""))
    state = read_state(state_path)
    # Claude Code hands its own turns to the hook wrapped and with nothing
    # before them; a person who quotes a tag later in a prompt is still a person.
    harness = prompt.lstrip().startswith(HARNESS_MARKS)
    kept = state.get("session_id") == session and state.get("owner") == "manual" and state.get("task")
    if not harness and not kept:
        state = {
            "state": "busy",
            "owner": "manual",
            "task": prompt.strip()[:TASK_LENGTH],
            "since": now(),
            "session_id": session,
        }
    state.pop("turn_ended", None)
    seat = {**state, "turn": "active", "turn_started": now()}
    write_atomically(state_path, json.dumps(seat) + "\n")


def started_within(state: dict[str, Any], window: timedelta) -> bool:
    """Whether the current turn started less than window ago."""
    try:
        started = datetime.fromisoformat(str(state["turn_started"]))
    except (KeyError, ValueError):
        return False
    # seat-state writes UTC with an offset; a time without one is not ours.
    if started.tzinfo is None:
        return False
    return datetime.now(UTC) - started < window


def on_stop(event: dict[str, Any], state_path: Path) -> None:
    """Stop and StopFailure end the turn; idle_prompt ends one older than IDLE_NOTICE_AFTER."""
    state = read_state(state_path)
    # idle_prompt also follows a turn that Stop already ended.
    if state.get("turn") == "idle":
        return
    # A late idle_prompt is about the turn before a prompt that just came in.
    if event.get("hook_event_name") == "Notification" and started_within(state, IDLE_NOTICE_AFTER):
        return
    write_atomically(state_path, json.dumps(idle(state)) + "\n")


def on_start(event: dict[str, Any], state_path: Path, pin_path: Path) -> None:
    """SessionStart: no turn is running; /clear frees the seat and pins the new session's UUID."""
    source = event.get("source")
    if source in ("startup", "resume"):
        write_atomically(state_path, json.dumps(idle(read_state(state_path))) + "\n")
    if source != "clear":
        return
    session = str(event.get("session_id", ""))
    seat = idle({"state": "free", "since": now(), "session_id": session})
    write_atomically(state_path, json.dumps(seat) + "\n")
    if UUID.match(session):
        write_atomically(pin_path, session + "\n")
    else:
        print(f"seat-state: session id {session!r} is not a UUID, not pinned", file=sys.stderr)


def main(argv: list[str]) -> int:
    home = Path.home()
    state_path = home / ".claude/seat-state.json"
    pin_path = home / ".config/josui/session-id"
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            raise ValueError("the event is not a JSON object")
        handlers = {
            "prompt": lambda: on_prompt(event, state_path),
            "stop": lambda: on_stop(event, state_path),
            "start": lambda: on_start(event, state_path, pin_path),
        }
        if len(argv) != 2 or argv[1] not in handlers:
            raise ValueError(f"usage: seat-state prompt|stop|start, not {argv[1:]}")
        state_path.parent.mkdir(parents=True, exist_ok=True)
        with open(state_path.parent / ".seat-state.lock", "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            handlers[argv[1]]()
    except (OSError, ValueError) as exc:
        print(f"seat-state: {exc}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
