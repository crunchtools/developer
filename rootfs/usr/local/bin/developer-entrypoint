#!/bin/bash
# Assemble Josui's Claude Code home from what was mounted, then serve Remote
# Control. Anything given as arguments runs instead, with the same home:
#   podman run -it ... quay.io/crunchtools/josui claude auth login
set -euo pipefail

config_dir=${JOSUI_CONFIG_DIR:?JOSUI_CONFIG_DIR is not set}
skills_repo=${JOSUI_SKILLS_DIR:?JOSUI_SKILLS_DIR is not set}
claude_dir="$HOME/.claude"
workdir=${JOSUI_WORKDIR:-$HOME/work}

log() { echo "josui: $*" >&2; }

# josui.env keeps the names it has always had; claude-agent reads its own.
for name in ANSWER_PERMISSIONS MAX_TOOL_CALLS MAX_REPEAT; do
  value="JOSUI_$name"
  if [ -n "${!value:-}" ]; then
    export "CLAUDE_AGENT_$name=${!value}"
  fi
done

mkdir -p "$claude_dir/skills" "$claude_dir/hooks" "$workdir"

# Identity is copied in, not linked: the mount is read-only and Claude Code
# rewrites its own settings file. The mounted copy wins again at next start.
for name in CLAUDE.md settings.json; do
  if [ -f "$config_dir/$name" ]; then
    install -m 0644 "$config_dir/$name" "$claude_dir/$name"
  else
    log "no $name in $config_dir"
  fi
done
# Only the image's managed hooks run (allowManagedHooksOnly), so a hook in
# this home, written by the agent or planted by a checkout, does nothing.
# Clear the old copies so nobody mistakes them for live ones.
find "$claude_dir/hooks" -mindepth 1 -delete
if [ -d "$config_dir/hooks" ]; then
  log "$config_dir/hooks is ignored: only the image's managed hooks run"
fi

# git reaches GitHub through the gateway's git route, which holds the GitHub
# token. Set up before the skills pull below, which goes the same way. git sends the gateway token, written to a file in the state volume
# like the state file above, so it is not handed to Claude Code in the
# environment. The global git config includes that file.
git_url=${TRENTINA_GIT_URL:-}
git_url=${git_url%/}
# It is written into git config syntax, so only a plain URL is accepted.
if [ -n "$git_url" ] && ! [[ "$git_url" =~ ^https?://[A-Za-z0-9.:-]+(/[A-Za-z0-9._-]+)*$ ]]; then
  log "TRENTINA_GIT_URL is not a plain http(s) URL, ignoring it"
  git_url=
fi
if [ -n "$git_url" ] && [ -n "${TRENTINA_MCP_TOKEN:-}" ]; then
  gitconf="$HOME/.config/josui/gateway.gitconfig"
  mkdir -p "$(dirname "$gitconf")"
  # printf is a builtin, so the token is never in a process's arguments.
  (
    umask 077
    rm -f "$gitconf"
    printf '[http "%s/"]\n\textraHeader = Authorization: Bearer %s\n[url "%s/github/"]\n\tinsteadOf = https://github.com/\n' \
      "$git_url" "$TRENTINA_MCP_TOKEN" "$git_url" > "$gitconf"
  )
  git config --global --get-all include.path | grep -qxF "$gitconf" ||
    git config --global --add include.path "$gitconf"
fi
# Skills are a git checkout on a volume. A failed pull is not fatal: the
# checkout that is there still works, and the network may be the thing down.
if [ -d "$skills_repo/.git" ]; then
  git -C "$skills_repo" pull --ff-only --quiet || log "skills pull failed, using the checkout as it is"
fi
find "$claude_dir/skills" -mindepth 1 -maxdepth 1 -type l -delete
if [ -d "$skills_repo/skills" ]; then
  for skill in "$skills_repo"/skills/*/; do
    ln -s "${skill%/}" "$claude_dir/skills/$(basename "$skill")"
  done
fi
if [ -d "$skills_repo/templates" ]; then
  ln -sfn "$skills_repo/templates" "$claude_dir/templates"
fi

# Claude Code's state file is JSON holding things only it knows about, so it
# is edited by merging rather than rewritten. python3 and not `jq`: jq is not
# in every image this script's own tests run in -- the python-sdlc container
# has python and no jq, and the whole suite failed on that -- and the token
# travels in the child's environment instead of its argv, where jq --arg put
# it.
edit_state_json() {
  local state="$HOME/.claude.json" tmp
  [ -s "$state" ] || echo '{}' > "$state"
  tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
  chmod 0600 "$tmp"
  if ! JOSUI_STATE_EDIT=$1 python3 -c '
import json, os, sys

with open(sys.argv[1]) as handle:
    state = json.load(handle)
if os.environ["JOSUI_STATE_EDIT"] == "gateway":
    state["mcpServers"] = {
        "trentina": {
            "type": "http",
            "url": os.environ["TRENTINA_MCP_URL"],
            "headers": {"Authorization": "Bearer " + os.environ["TRENTINA_MCP_TOKEN"]},
        }
    }
else:
    state["hasCompletedOnboarding"] = True
with open(sys.argv[2], "w") as handle:
    json.dump(state, handle)
' "$state" "$tmp"; then
    rm -f "$tmp"
    log "could not edit $state"
    return 1
  fi
  mv "$tmp" "$state"
}

# The gateway is the one MCP server. Its address and token come from the
# environment and are merged into the state file Claude Code reads, keeping
# whatever else Claude Code has stored there.
if [ -n "${TRENTINA_MCP_URL:-}" ] && [ -n "${TRENTINA_MCP_TOKEN:-}" ]; then
  edit_state_json gateway
else
  log "TRENTINA_MCP_URL / TRENTINA_MCP_TOKEN not set, starting without a gateway"
fi

# Kept for install_gatehouse_env, which runs after install_mcp_env and so
# cannot read the variable this line removes. The token is already on disk in
# the state file written just above, at 0600, so holding it in one more 0600
# file adds no exposure the seat did not already have. The `unset` stands:
# nothing the agent starts inherits it.
gateway_token=${TRENTINA_MCP_TOKEN:-}
unset TRENTINA_MCP_TOKEN

# The text session, when a homeserver is configured: claude-agent run holds an
# interactive session and starts its Matrix bridge beside it. The bridge keeps
# the sync position the old channel kept, so texts sent across the upgrade
# arrive. The session is interactive, so onboarding is recorded as done; the
# working directory's trust question is left to the operator (see README).
# Audit files are pruned by claude-agent's audit hook itself.
session=
if [ -n "${JOSUI_MATRIX_HOMESERVER:-}" ]; then
  export CLAUDE_AGENT_MATRIX_HOMESERVER=$JOSUI_MATRIX_HOMESERVER
  export CLAUDE_AGENT_MATRIX_TOKEN_FILE=${JOSUI_MATRIX_TOKEN_FILE:-/etc/josui-matrix/token}
  export CLAUDE_AGENT_MATRIX_ALLOW=${JOSUI_MATRIX_ALLOW:-}
  export CLAUDE_AGENT_MATRIX_STATE=$HOME/.config/josui/matrix-sync
  edit_state_json onboarded
  session=1
fi

if [ "$#" -gt 0 ]; then
  exec "$@"
fi

# Remote Control POLLS: it opens a connection to the proxy about once every
# thirty to two hundred seconds and closes it in about a second. 0.6.0 shipped
# a watchdog that sampled /proc/net/tcp for a connection and ended the
# container when it saw none, which on this evidence restarts a HEALTHY idle
# container -- measured on gloval 2026-11-06, one hit in ten samples over two
# minutes against a container that was polling normally. There is no cheap
# local signal for "the bridge is alive": the debug file does not grow while
# idle either.
#
# What the debug file DID do, the first time it was read, was say why Josui
# Prime had no session: a work item created days earlier that the server ends
# with reason=archived the moment the bridge picks it up, after which the
# bridge returns to idle with no session at all. No watchdog would have found
# that, and restarting never fixed it. So the file stays and the watchdog goes
# (RT#1556).

# A person's own terminal inside the container, for a copy that is worked in
# rather than only texted and driven from the app:
#
#   podman exec -it <service> tmux attach -t dev
#
# tmux rather than `claude-agent attach --rw`, which renders the supervised
# session at the fixed size the supervisor set rather than the attaching
# terminal's. Deliberately NOT in the pid list below: someone exiting their
# own shell must not take the container down with it.
start_tmux_session() {
  local tmux=${JOSUI_TMUX_CMD:-tmux}
  if ! command -v "$tmux" > /dev/null 2>&1; then
    log "JOSUI_TMUX is set but there is no $tmux in this image"
    return
  fi
  if "$tmux" has-session -t dev 2>/dev/null; then
    return
  fi
  if ! "$tmux" new-session -d -s dev -c "$workdir" \
      claude --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}"; then
    log "could not start the tmux session; carrying on without a terminal"
    return
  fi
  # Quitting Claude Code leaves the pane to be respawned (prefix + :respawn-pane)
  # instead of ending the session and losing the window layout with it.
  "$tmux" set-option -t dev remain-on-exit on 2>/dev/null || true
  "$tmux" new-window -d -t dev -c "$workdir" 2>/dev/null || true
  log "tmux session 'dev' is up: podman exec -it <service> tmux attach -t dev"
}

# What a seat needs before `sdlc push` can run at all. Each of these was a
# failure measured on developer3 against a trentina clone (RT#1556), not a
# precaution: a seat without them reports a gate as "COULD NOT RUN", which is
# the one verdict that must never be worked around.
#
# A git identity, because a seat starts with none and several gates commit or
# diff. Only when nothing is configured already: a person who sets their own
# in the state volume keeps it.
set_git_identity() {
  local name=${JOSUI_GIT_NAME:-} email=${JOSUI_GIT_EMAIL:-}
  [ -n "$name" ] || [ -n "$email" ] || return 0
  if [ -n "$name" ] && ! git config --global --get user.name > /dev/null 2>&1; then
    git config --global user.name "$name"
  fi
  if [ -n "$email" ] && ! git config --global --get user.email > /dev/null 2>&1; then
    git config --global user.email "$email"
  fi
  # A detached HEAD is normal here: a pinned tool is cloned at its tag.
  git config --global advice.detachedHead false
}

# Env files for the tools that take a key, mounted read-only the way the
# identity is. Gatehouse dies without ~/.config/mcp-env/gatehouse.env, and
# that file holds an API key, so it belongs in a mount and not in the image
# and not in this container's environment, where `envscrub` would find it.
install_mcp_env() {
  local src="$config_dir/mcp-env" dest="$HOME/.config/mcp-env" name
  [ -d "$src" ] || return 0
  mkdir -p "$dest"
  chmod 0700 "$dest"
  local found=0
  for name in "$src"/*.env; do
    [ -f "$name" ] || continue
    install -m 0600 "$name" "$dest/$(basename "$name")"
    found=$((found + 1))
  done
  if [ "$found" -eq 0 ]; then
    log "$src has no *.env files"
    return 0
  fi
  log "installed $found env file(s) from $src"
}

# Gatehouse through the gateway, not straight to OpenRouter.
#
# Gatehouse reads ~/.config/mcp-env/gatehouse.env and needs an LLM. Pointed at
# openrouter.ai it needs an OpenRouter key of its own, and that key was mounted
# into every seat -- a second, spendable copy of a credential the gateway
# already holds, with no per-seat accounting and no revocation short of editing
# files on the host (RT#1559).
#
# The gateway serves OpenRouter twice, under two names, and this takes the one
# that is Gatehouse's alone. `llm_keys` is both the L3 defense judge's
# credential and what the proxy injects, so a single provider put judging and
# Gatehouse on one key and made per-function spend unreadable; the
# openrouter-gatehouse route carries its own key and the judge keeps
# `openrouter`. Pointing this at `openrouter` still works and is the wrong
# thing: it bills Gatehouse to whatever this profile judges with.
#
# The gateway serves it with the seat's own token, so that is what this
# writes. Gatehouse appends
# /chat/completions to the base URL, and the gateway's openrouter upstream is
# https://openrouter.ai/api, so the base URL carries the /v1 between them.
#
# Plain http to a private address, on purpose: the gateway has no TLS listener
# on the container bridge, and Gatehouse accepts http for a loopback or
# private host, where the key does not cross a network this host does not
# control.
#
# That needs Gatehouse 0.24.0, which is the floor for this whole route.
# 0.23.0 and earlier ignore GATEHOUSE_LLM_BASE_URL entirely and would send the
# gateway token to openrouter.ai as an OpenRouter key: a 401, and a gate that
# fails rather than one that could not run, which is worse. Gatehouse is baked
# into the python-sdlc image at a pin the PUSHED repo chooses, so this image
# cannot establish that floor for anything but itself.
#
# A gatehouse.env in the mount WINS, and this writes nothing when one is
# there. That is the opposite of what it did when first written, and the
# reason is the Gatehouse floor below: a seat pushes many repos, and each one
# pins its OWN python-sdlc rev, so the Gatehouse a gate runs is the pushed
# repo's choice and not this image's. While any repo a seat pushes is still
# pinned below python-sdlc v0.5.2, flipping this file breaks that repo's gate.
#
# So deleting the mounted key is the cutover, per seat, under an operator's
# hand -- and re-placing it is the rollback. Deploying this image changes
# nothing by itself, which is what makes it safe to deploy before the fleet
# has caught up.
#
# `provider: {"zdr": true, "data_collection": "deny"}` rides in Gatehouse's
# request body because the reviewed diff is private code. `provider` is an
# allowed key on the gateway's OpenRouter shape and the body is forwarded
# verbatim, so the guarantee survives the move -- verified 2026-11-07 against
# the live gateway, which returned 200 rather than refusing it as an unknown
# parameter. If that shape ever narrows, this route stops being safe to use.
install_gatehouse_env() {
  local dest="$HOME/.config/mcp-env" file="$HOME/.config/mcp-env/gatehouse.env"
  # The MOUNT decides, never the destination. $HOME is a persistent volume, so
  # a gatehouse.env in $dest may be one THIS function wrote at a previous
  # start -- and testing the destination would then read its own output as an
  # operator's choice, leave a rotated token stale, and log the wrong reason.
  # Gatehouse's review of the first version of this caught exactly that.
  local mounted="$config_dir/mcp-env/gatehouse.env"
  local url=""
  if [ -n "${TRENTINA_MCP_URL:-}" ]; then
    # Derived from the MCP endpoint, never settable on its own. This file
    # carries the gateway token, so anything able to set the URL
    # independently could redirect that token to an endpoint of its choosing.
    # Gatehouse's own review of this change raised exactly that, correctly.
    url="${TRENTINA_MCP_URL%%/gateway/*}/proxy/llm/openrouter-gatehouse/v1"
  fi
  if [ -z "${gateway_token:-}" ] || [ -z "$url" ]; then
    # No gateway identity: leave whatever the mount provided. A seat without a
    # token cannot use the gateway route at all, and failing here would take
    # away the only Gatehouse this seat can run.
    log "no gateway token or URL; gatehouse.env left as mounted"
    return 0
  fi
  if [ -f "$mounted" ]; then
    # Loud, because a key left in the mount keeps a seat off the gateway route
    # indefinitely and nothing else would say so.
    log "gatehouse.env is mounted; NOT using the gateway route (RT#1559)"
    return 0
  fi
  # $HOME is a persistent volume the agent can write, so no component of this
  # path may be followed if it is a symlink: `mkdir -p` follows a symlinked
  # ancestor, and a write through it would put the gateway token under
  # whatever it pointed at and clobber what was there. Every component is
  # checked and created one at a time rather than with `mkdir -p`, because
  # checking only the last one leaves $HOME/.config as the way in. Gatehouse's
  # review found first the file, then the directory, then the ancestor.
  #
  # This is hygiene, not a boundary, and it is worth being clear about which:
  # anything that can plant a symlink here runs as this user, and this user's
  # Claude Code state file already holds the same gateway token at 0600. What
  # the check buys is that a seat cannot be made to overwrite an arbitrary
  # file, and that a swapped path is refused rather than followed. A
  # check-then-create in shell still has a window between the two; closing
  # that needs openat(O_NOFOLLOW) and a program that is not this one.
  local dir="$HOME" part
  for part in .config mcp-env; do
    dir="$dir/$part"
    if [ -L "$dir" ]; then
      log "$dir is a symlink; refusing to write a token through it"
      return 0
    fi
    if [ ! -d "$dir" ] && ! mkdir -m 0700 "$dir"; then
      log "cannot create $dir; gatehouse.env not written"
      return 0
    fi
  done
  chmod 0700 "$dest"
  # Written to a fresh file and renamed over the destination. rename(2)
  # replaces a symlink AT the destination rather than following it, and it is
  # atomic, so a gate reading this file concurrently sees one version or the
  # other and never a half-written one. mktemp creates at 0600 whatever the
  # umask is, which is the other half of the token never being readable.
  local tmp
  tmp=$(mktemp "$dest/.gatehouse.env.XXXXXX") || {
    log "cannot create a temporary file in $dest; gatehouse.env not written"
    return 0
  }
  # Rewritten at every start, replacing whatever a previous start left: the
  # seat token rotates, and a stale one is a gate that fails rather than one
  # that could not run.
  cat > "$tmp" <<ENVEOF
# Written by developer-entrypoint at container start. Do not edit: it is
# replaced on every start. See RT#1559.
GATEHOUSE_LLM_BASE_URL=$url
OPENROUTER_API_KEY=$gateway_token
ENVEOF
  mv -f "$tmp" "$file"
  log "gatehouse.env points at the gateway: $url"
}

set_git_identity
install_mcp_env
install_gatehouse_env

cd "$workdir"
# Remote Control redraws a terminal status screen on stdout every second.
# Under a container runtime that is a line a second into the journal, so
# stdout is dropped; errors still go to stderr.
# Telemetry is off for both Claude processes.
export DISABLE_TELEMETRY=1
server_args=(
  remote-control
  --spawn same-dir
  --capacity "${JOSUI_CAPACITY:-2}"
  --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}"
)
# Session creation can fail in a way nothing else reports: on 2026-10-11 a
# workdir that was a git checkout made Anthropic refuse every session with an
# HTTP 400, and the only trace was in this file. It is truncated at each start
# and capped by the watchdog above.
debug_file=${JOSUI_DEBUG_FILE:-}
if [ -z "$debug_file" ] && [ -n "${CLAUDE_AGENT_AUDIT_DIR:-}" ] && [ -d "${CLAUDE_AGENT_AUDIT_DIR:-}" ]; then
  debug_file="$CLAUDE_AGENT_AUDIT_DIR/remote-control.log"
fi
if [ -n "$debug_file" ] && : > "$debug_file" 2>/dev/null; then
  # Emptied here, at each start, which is the only cap it has now that there is
  # no loop to trim it. Claude Code writes a per-session file beside it too.
  server_args+=(--debug-file "$debug_file")
else
  [ -z "$debug_file" ] || log "cannot write $debug_file, running without a debug file"
  debug_file=
fi
server_args+=(--remote-control-session-name-prefix "${JOSUI_NAME:-josui}")

# The Remote Control server and -- when a homeserver is configured --
# claude-agent, side by side. When either ends the container ends, and the
# unit restarts both.
pids=()
claude "${server_args[@]}" > /dev/null &
pids+=($!)
if [ -n "$session" ]; then
  claude-agent run -- --permission-mode "${JOSUI_PERMISSION_MODE:-acceptEdits}" &
  pids+=($!)
fi
if [ -n "${JOSUI_TMUX:-}" ]; then
  start_tmux_session
fi
trap 'kill "${pids[@]}" 2>/dev/null' TERM INT
status=0
wait -n "${pids[@]}" || status=$?
log "a supervised process ended (status $status), stopping"
kill "${pids[@]}" 2>/dev/null || true
wait || true
exit "$status"
