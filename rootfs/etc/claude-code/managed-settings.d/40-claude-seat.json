{
  "autoCompactWindow": 500000,
  "permissions": {
    "deny": [
      "EnterPlanMode"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/seat-state prompt",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/ashigaru-hook prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/seat-state start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/ashigaru-hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/seat-state stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/ashigaru-hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/seat-state stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/ashigaru-hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/seat-state stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/libexec/claude-seat/ashigaru-hook stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
